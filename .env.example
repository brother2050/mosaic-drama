# ============================================================
# AI 短剧管线 v2 — 环境变量配置
# ============================================================

# PostgreSQL（必须）
# 先创建数据库: CREATE DATABASE ai_drama;
AI_DRAMA_DB_DSN=postgresql://drama:drama_change_me@127.0.0.1:5432/ai_drama

# API 鉴权 Token（本地部署可选，留空则不校验）
AI_DRAMA_API_TOKEN=

# ── Mosaic 离线模式 — 不需要任何 LLM / 在线服务的 API Key ──
# 项目已迁移到 Mosaic 离线框架，LLM、TTS、图像/视频生成均由本地引擎完成。
# 如需切换回在线 LLM 服务，可在 system.yaml 的 llm.api_key 中手动填入。

# TTS 语音合成 — 使用 Mosaic 离线引擎，无需任何 API Key
# （已移除 MiMo / GPT-SoVITS / CosyVoice / Fish-Speech / ChatTTS 等在线 TTS 后端）

# Redis（必选 — Celery 任务队列）
REDIS_URL=redis://localhost:6379/0

# Redis 结果后端（可选，默认与 REDIS_URL 同地址的 db1）
# REDIS_BACKEND_URL=redis://localhost:6379/1

# CORS 跨域（可选，逗号分隔多个域名）
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# MusicGen API Key（AI 配乐生成 — 可选，自部署时可留空）
# RUNPOD_API_TOKEN=

# HuggingFace 镜像（模型下载加速）
# HF_ENDPOINT=https://hf-mirror.com
